--- /dev/null
+++ clone/public/uploads/.htaccess
@@ -0,0 +1,20 @@
+# BEGIN WebGuard:noexec
+<FilesMatch "\.(php[0-9]?|pht|phtml|phar|inc|pl|py|cgi|sh)$">
+  <IfModule mod_authz_core.c>
+    Require all denied
+  </IfModule>
+  <IfModule !mod_authz_core.c>
